        { "zh": "三品", "en": "Third Grade",   "abbr": "G3", "eloMin": 1500, "eloMax": 1599, "palette": "gradeHigh" },
        { "zh": "二品", "en": "Second Grade",  "abbr": "G2", "eloMin": 1600, "eloMax": 1699, "palette": "gradeHigh" },
        { "zh": "一品", "en": "First Grade",   "abbr": "G1", "eloMin": 1700, "eloMax": 1799, "palette": "gradeHigh" },
