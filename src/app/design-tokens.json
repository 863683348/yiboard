{
  "$meta": {
    "product": "弈界 YiBoard",
    "version": "0.1.0-draft",
    "designLanguage": "格律 Lattice — 棋盘格律 / 墨石中性 / 朱印一点",
    "owner": "颜好看 (UI/UX)",
    "format": "DTCG-like (value + type)",
    "notes": [
      "本文件为前端唯一的设计取值来源。组件内禁止出现裸 hex（#fff / #000 除外）。",
      "两条正交主题轴：mode(light|dark) 与 board(ink|kaya|slate)，不要耦合。",
      "与 design-tokens.css 一一对应；CSS 中的 color-mix 派生值在此处给出已计算的近似值。"
    ],
    "scales": {
      "DESIGN_VARIANCE": 6,
      "MOTION_INTENSITY": 6,
      "VISUAL_DENSITY_by_surface": {
        "home": 4,
        "lobby": 6,
        "game": 5,
        "leaderboard": 7,
        "account": 5
      }
    },
    "iconLibrary": {
      "name": "Phosphor Icons",
      "package": "@phosphor-icons/react",
      "license": "MIT",
      "lockedWeights": ["regular", "fill", "bold"],
      "usage": {
        "regular": "默认，用于 20px / 24px",
        "fill": "仅用于底部导航/Tab 激活态与评分星标",
        "bold": "仅用于 16px 行内图标的光学补偿"
      },
      "sizes": { "sm": 16, "md": 20, "lg": 24 },
      "rule": "全项目仅此一套，禁止混用 Lucide/Tabler/Heroicons/Material；禁止 emoji 作功能图标"
    }
  },

  "font": {
    "family": {
      "display": { "value": "Archivo, 'Noto Sans SC', 'Noto Sans TC', system-ui, sans-serif", "type": "fontFamily" },
      "body":    { "value": "Inter, 'Noto Sans SC', 'Noto Sans TC', system-ui, sans-serif", "type": "fontFamily" },
      "mono":    { "value": "'JetBrains Mono', ui-monospace, SFMono-Regular, monospace", "type": "fontFamily" }
    },
    "size": {
      "xs":      { "value": "0.75rem",  "type": "dimension", "px": 12 },
      "sm":      { "value": "0.875rem", "type": "dimension", "px": 14 },
      "base":    { "value": "1rem",     "type": "dimension", "px": 16 },
      "lg":      { "value": "1.125rem", "type": "dimension", "px": 18 },
      "xl":      { "value": "1.25rem",  "type": "dimension", "px": 20 },
      "2xl":     { "value": "1.5rem",   "type": "dimension", "px": 24 },
      "3xl":     { "value": "2rem",     "type": "dimension", "px": 32 },
      "4xl":     { "value": "2.5rem",   "type": "dimension", "px": 40 },
      "display": { "value": "clamp(2.5rem, 1.6rem + 3.6vw, 4.25rem)", "type": "dimension", "note": "40->68px，仅首页 Hook 标题，一屏一次" }
    },
    "weight": {
      "read":     { "value": 400, "type": "fontWeight" },
      "emphasis": { "value": 510, "type": "fontWeight", "cjkFallback": 500 },
      "announce": { "value": 590, "type": "fontWeight", "cjkFallback": 700 }
    },
    "lineHeight": {
      "tight":   { "value": 1.12, "type": "number" },
      "snug":    { "value": 1.32, "type": "number" },
      "body":    { "value": 1.6,  "type": "number" },
      "bodyCjk": { "value": 1.75, "type": "number" },
      "mono":    { "value": 1.45, "type": "number" }
    },
    "tracking": {
      "display": { "value": "-0.025em", "type": "dimension", "cjkOverride": "0em" },
      "3xl":     { "value": "-0.02em",  "type": "dimension", "cjkOverride": "0em" },
      "2xl":     { "value": "-0.015em", "type": "dimension", "cjkOverride": "0em" },
      "body":    { "value": "0em",      "type": "dimension" },
      "small":   { "value": "0.01em",   "type": "dimension" },
      "caps":    { "value": "0.08em",   "type": "dimension", "note": "ALL CAPS 强制，中文不适用" }
    }
  },

  "space": {
    "1":  { "value": "4px",  "type": "dimension" },
    "2":  { "value": "8px",  "type": "dimension" },
    "3":  { "value": "12px", "type": "dimension" },
    "4":  { "value": "16px", "type": "dimension" },
    "5":  { "value": "20px", "type": "dimension" },
    "6":  { "value": "24px", "type": "dimension" },
    "8":  { "value": "32px", "type": "dimension" },
    "10": { "value": "40px", "type": "dimension" },
    "12": { "value": "48px", "type": "dimension" },
    "16": { "value": "64px", "type": "dimension" },
    "20": { "value": "80px", "type": "dimension" }
  },

  "radius": {
    "sm":   { "value": "6px",    "type": "dimension", "use": "按钮 / 输入框 / 徽章" },
    "md":   { "value": "10px",   "type": "dimension", "use": "卡片 / 面板 / 下拉" },
    "lg":   { "value": "14px",   "type": "dimension", "use": "棋盘容器 / 模态（上限）" },
    "pill": { "value": "9999px", "type": "dimension", "use": "棋子 / 头像 / 段位章" }
  },

  "layout": {
    "containerMax":        { "value": "1200px", "type": "dimension" },
    "containerMaxReading": { "value": "680px",  "type": "dimension" },
    "gutter": {
      "desktop": { "value": "24px", "type": "dimension" },
      "tablet":  { "value": "16px", "type": "dimension" },
      "phone":   { "value": "12px", "type": "dimension" }
    },
    "sectionY": {
      "desktop": { "value": "80px", "type": "dimension" },
      "tablet":  { "value": "48px", "type": "dimension" },
      "phone":   { "value": "32px", "type": "dimension" }
    },
    "breakpoint": {
      "sm": { "value": "640px",  "type": "dimension" },
      "md": { "value": "768px",  "type": "dimension" },
      "lg": { "value": "1024px", "type": "dimension" },
      "xl": { "value": "1280px", "type": "dimension" }
    },
    "touchTargetMin": { "value": "44px", "type": "dimension", "note": "WCAG 2.5.5" }
  },

  "motion": {
    "duration": {
      "instant": { "value": "90ms",  "type": "duration", "use": "按下 / 开关" },
      "fast":    { "value": "150ms", "type": "duration", "use": "hover / 选中" },
      "base":    { "value": "200ms", "type": "duration", "use": "展开 / Toast" },
      "slow":    { "value": "300ms", "type": "duration", "use": "模态 / 页面过渡" },
      "stone":   { "value": "160ms", "type": "duration", "use": "落子（签名微交互）" }
    },
    "easing": {
      "standard": { "value": "cubic-bezier(0.2, 0, 0, 1)",    "type": "cubicBezier" },
      "exit":     { "value": "cubic-bezier(0.4, 0, 1, 1)",    "type": "cubicBezier" },
      "stone":    { "value": "cubic-bezier(0.16, 1, 0.3, 1)", "type": "cubicBezier", "note": "只减速不回弹——棋子落下不会弹起" }
    },
    "reducedMotion": { "value": "1ms", "type": "duration", "note": "prefers-reduced-motion 下全部降级" }
  },

  "color": {
    "light": {
      "bg":            { "value": "#F3F4F5", "type": "color", "layer": "A1", "note": "冷中性石色，刻意避开米色/奶油" },
      "surface":       { "value": "#FFFFFF", "type": "color", "layer": "A1" },
      "surfaceSunken": { "value": "#E9EBEC", "type": "color", "layer": "B" },
      "surfaceHover":  { "value": "#F7F8F8", "type": "color", "layer": "B" },

      "fg":    { "value": "#16191C", "type": "color", "layer": "A1", "contrastOnSurface": "17.0:1" },
      "fg2":   { "value": "#3A4149", "type": "color", "layer": "B",  "contrastOnSurface": "10.3:1" },
      "muted": { "value": "#5A626A", "type": "color", "layer": "A1", "contrastOnSurface": "6.2:1" },
      "meta":  { "value": "#6F777F", "type": "color", "layer": "B",  "contrastOnSurface": "4.6:1", "note": "阶梯下限，禁止再淡" },

      "border":       { "value": "#D9DDE0", "type": "color", "layer": "A1" },
      "borderSoft":   { "value": "#E8EBED", "type": "color", "layer": "B" },
      "borderStrong": { "value": "#BFC5CA", "type": "color", "layer": "B" },

      "accent":       { "value": "#BE4A2F", "type": "color", "layer": "A1", "name": "朱砂 Cinnabar", "contrastOnWhite": "4.97:1", "rule": "每屏可见 <=2 处" },
      "accentOn":     { "value": "#FFFFFF", "type": "color", "layer": "A2" },
      "accentHover":  { "value": "#AF442B", "type": "color", "layer": "A2" },
      "accentActive": { "value": "#A34028", "type": "color", "layer": "A2" },
      "accentSoft":   { "value": "#F9EDEA", "type": "color", "layer": "B" },
      "accentRing":   { "value": "rgba(190, 74, 47, 0.30)", "type": "color", "layer": "B" },

      "info":    { "value": "#1B5E7E", "type": "color", "layer": "A2", "name": "石青 Azurite", "contrastOnWhite": "7.1:1" },
      "success": { "value": "#2E7D5B", "type": "color", "layer": "A2", "name": "松绿",         "contrastOnWhite": "5.1:1" },
      "warn":    { "value": "#9A6B0A", "type": "color", "layer": "A2", "name": "姜黄",         "contrastOnWhite": "4.8:1" },
      "danger":  { "value": "#C0293C", "type": "color", "layer": "A2", "name": "绛红",         "contrastOnWhite": "5.8:1", "note": "冷调，与朱砂拉开约 20 度色相" },

      "infoSoft":    { "value": "#EBF2F5", "type": "color", "layer": "B" },
      "successSoft": { "value": "#EDF5F1", "type": "color", "layer": "B" },
      "warnSoft":    { "value": "#F7F1E4", "type": "color", "layer": "B" },
      "dangerSoft":  { "value": "#F8EAEC", "type": "color", "layer": "B" }
    },

    "dark": {
      "bg":            { "value": "#0F1214", "type": "color", "layer": "A1" },
      "surface":       { "value": "#171B1E", "type": "color", "layer": "A1" },
      "surfaceSunken": { "value": "#101416", "type": "color", "layer": "B" },
      "surfaceHover":  { "value": "#1F2428", "type": "color", "layer": "B" },

      "fg":    { "value": "#E8EBED", "type": "color", "layer": "A1" },
      "fg2":   { "value": "#C2C8CD", "type": "color", "layer": "B" },
      "muted": { "value": "#98A0A7", "type": "color", "layer": "A1" },
      "meta":  { "value": "#7E868D", "type": "color", "layer": "B" },

      "border":       { "value": "#2A3034", "type": "color", "layer": "A1" },
      "borderSoft":   { "value": "rgba(255,255,255,0.06)", "type": "color", "layer": "B" },
      "borderStrong": { "value": "#3B4348", "type": "color", "layer": "B" },

      "accent":       { "value": "#E0664A", "type": "color", "layer": "A1", "name": "炭上朱", "contrastOnBg": "5.6:1" },
      "accentOn":     { "value": "#180B07", "type": "color", "layer": "A2", "note": "暗色下填充按钮用深色字，比白字更耐看且对比更高" },
      "accentHover":  { "value": "#E37258", "type": "color", "layer": "A2" },
      "accentActive": { "value": "#E47B63", "type": "color", "layer": "A2" },
      "accentSoft":   { "value": "#2C1D18", "type": "color", "layer": "B" },
      "accentRing":   { "value": "rgba(224, 102, 74, 0.38)", "type": "color", "layer": "B" },

      "info":    { "value": "#58A6C8", "type": "color", "layer": "A2", "contrastOnBg": "7.0:1" },
      "success": { "value": "#4CAF82", "type": "color", "layer": "A2", "contrastOnBg": "7.0:1" },
      "warn":    { "value": "#D9A441", "type": "color", "layer": "A2", "contrastOnBg": "8.4:1" },
      "danger":  { "value": "#F2555F", "type": "color", "layer": "A2", "contrastOnBg": "5.7:1" },

      "infoSoft":    { "value": "#182B33", "type": "color", "layer": "B" },
      "successSoft": { "value": "#172A23", "type": "color", "layer": "B" },
      "warnSoft":    { "value": "#2A2418", "type": "color", "layer": "B" },
      "dangerSoft":  { "value": "#2C1A1D", "type": "color", "layer": "B" }
    }
  },

  "elevation": {
    "light": {
      "flat":    { "value": "none", "type": "boxShadow" },
      "ring":    { "value": "0 0 0 1px #D9DDE0", "type": "boxShadow" },
      "raised":  { "value": "0 1px 2px rgba(22,25,28,0.05), 0 4px 10px rgba(22,25,28,0.06)", "type": "boxShadow" },
      "overlay": { "value": "0 8px 28px rgba(22,25,28,0.14)", "type": "boxShadow" }
    },
    "dark": {
      "flat":    { "value": "none", "type": "boxShadow" },
      "ring":    { "value": "0 0 0 1px #2A3034", "type": "boxShadow" },
      "raised":  { "value": "0 0 0 1px #2A3034", "type": "boxShadow", "note": "暗色靠 surface 提亮表达抬升，不靠阴影" },
      "overlay": { "value": "0 12px 36px rgba(0,0,0,0.6)", "type": "boxShadow" }
    },
    "rule": "同一元素禁止同时出现 1px border 与 blur>=16px 的阴影（幽灵卡片）"
  },

  "focus": {
    "light": { "value": "0 0 0 2px #FFFFFF, 0 0 0 4px #BE4A2F", "type": "boxShadow" },
    "dark":  { "value": "0 0 0 2px #0F1214, 0 0 0 4px #E0664A", "type": "boxShadow" },
    "rule": "禁止 outline:none 且不提供替代；棋盘交叉点使用方形准星以区别于圆形落点提示"
  },

  "game": {
    "board": {
      "geometry": {
        "maxDesktop":    { "value": "min(640px, calc(100vh - 260px))", "type": "dimension" },
        "maxPhone":      { "value": "min(100vw - 24px, calc(100vh - 220px))", "type": "dimension" },
        "padding":       { "value": "16px", "type": "dimension" },
        "lineWidth":     { "value": "1px",  "type": "dimension" },
        "lineWidthEdge": { "value": "1.5px","type": "dimension" },
        "starSize":      { "value": "6px",  "type": "dimension" },
        "cellMinTouch":  { "value": "28px", "type": "dimension", "note": "低于此值必须启用两段式落子（拖拽预览 + 确认）" },
        "stoneScale":    { "value": 0.86,   "type": "number",    "note": "棋子直径 / 格宽" }
      },
      "theme": {
        "ink": {
          "label": "墨石 Ink Stone（默认）",
          "light": { "surface": "#DCDEDF", "line": "#9BA2A7", "edge": "#7E868C", "star": "#6F777F", "coord": "#6F777F", "frame": "#BFC5CA" },
          "dark":  { "surface": "#262B2E", "line": "#4E565B", "edge": "#687177", "star": "#7E868D", "coord": "#7E868D", "frame": "#3B4348" }
        },
        "kaya": {
          "label": "榧木 Kaya（传统暖木，仅棋盘，绝不外溢到页面背景）",
          "light": { "surface": "#E3C88C", "line": "#7A5A2E", "edge": "#5E4420", "star": "#5E4420", "coord": "#6B4E28", "frame": "#8A6636" },
          "dark":  { "surface": "#A98547", "line": "#5A3F1C", "edge": "#452F13", "star": "#452F13", "coord": "#E8DCC2", "frame": "#6B4E28" }
        },
        "slate": {
          "label": "青石 Slate（高对比，无障碍首选）",
          "light": { "surface": "#C9CFD3", "line": "#6B7378", "edge": "#4E565B", "star": "#4E565B", "coord": "#4E565B", "frame": "#8A9298" },
          "dark":  { "surface": "#333A3E", "line": "#5F686E", "edge": "#808A90", "star": "#808A90", "coord": "#B4BCC1", "frame": "#4A5257" }
        }
      }
    },
    "stone": {
      "light": {
        "black":     { "value": "#1B1E20", "type": "color" },
        "blackEdge": { "value": "#000000", "type": "color" },
        "blackSpec": { "value": "rgba(255,255,255,0.22)", "type": "color" },
        "white":     { "value": "#FAFBFB", "type": "color" },
        "whiteEdge": { "value": "#C6CACD", "type": "color" },
        "whiteSpec": { "value": "rgba(255,255,255,0.90)", "type": "color" },
        "shadow":    { "value": "0 1px 2px rgba(22,25,28,0.28)", "type": "boxShadow" }
      },
      "dark": {
        "black":     { "value": "#14171A", "type": "color" },
        "blackEdge": { "value": "#000000", "type": "color" },
        "blackSpec": { "value": "rgba(255,255,255,0.18)", "type": "color" },
        "white":     { "value": "#EDEFF0", "type": "color" },
        "whiteEdge": { "value": "#9AA1A6", "type": "color" },
        "whiteSpec": { "value": "rgba(255,255,255,0.85)", "type": "color" },
        "shadow":    { "value": "0 1px 3px rgba(0,0,0,0.65)", "type": "boxShadow" }
      },
      "note": "黑白棋子天然色盲安全：靠明度而非色相区分"
    },
    "xiangqiSide": {
      "light": {
        "redFace":   { "value": "#F4ECE4", "type": "color" },
        "redInk":    { "value": "#A32B24", "type": "color" },
        "redEdge":   { "value": "#C99A86", "type": "color" },
        "blackFace": { "value": "#22262A", "type": "color" },
        "blackInk":  { "value": "#F2F4F5", "type": "color" },
        "blackEdge": { "value": "#0C0E10", "type": "color" }
      },
      "dark": {
        "redFace":   { "value": "#E9DCD2", "type": "color" },
        "redInk":    { "value": "#9E2A22", "type": "color" },
        "redEdge":   { "value": "#6E4B3C", "type": "color" },
        "blackFace": { "value": "#1A1E21", "type": "color" },
        "blackInk":  { "value": "#E8EBED", "type": "color" },
        "blackEdge": { "value": "#000000", "type": "color" }
      },
      "a11yRule": "红绿色盲下红子与黑子色相接近——必须靠棋子盘面明度区分：红方=浅盘面+深红字，黑方=深盘面+浅字"
    },
    "marker": {
      "last":   { "light": "#BE4A2F", "dark": "#E0664A", "form": "环形描边",   "note": "最后一手" },
      "legal":  { "light": "rgba(27,94,126,0.34)",  "dark": "rgba(88,166,200,0.34)", "form": "实心小圆点", "note": "合法落点" },
      "hint":   { "light": "rgba(27,94,126,0.62)",  "dark": "rgba(88,166,200,0.62)", "form": "虚线环",     "note": "AI 建议" },
      "win":    { "light": "#BE4A2F", "dark": "#E0664A", "form": "贯穿实线 + 端点圆头", "note": "成五连线" },
      "danger": { "light": "#C0293C", "dark": "#F2555F", "form": "叉形",       "note": "Renju 禁手" },
      "rule": "所有标记一律形状+颜色双编码，禁止只靠颜色传达"
    },
