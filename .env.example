# 弈界 YiBoard — 环境变量说明
# 复制为 .env.local 后按需填写。除 SITE_URL 外均可留空跑本地（内存 store + 开发密钥）。

# ── 必配（生产）────────────────────────────────────
# 访客 JWT 签名密钥，至少 32 字符。生产不配置会直接拒绝启动（防止用弱默认密钥上线）。
YB_AUTH_SECRET=

# ── 可选：Neon Postgres（P0 上线前接入 drizzle 适配层后生效）──
# 不配置 → 内存 store（进程重启即清空，仅适合本地/预览）。
DATABASE_URL=

# ── 可选：站点绝对地址（sitemap / robots / canonical 用）──
# Vercel 部署时建议设为正式域名，如 https://yiboard.com
SITE_URL=

# ── 可选：P1 起用（waffo MoR / GA4）──────────────────
# WAFFO_API_KEY=
# NEXT_PUBLIC_GA_ID=
